# Supabase project (Project Settings → API). For local dev run `supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Only for the setup/test scripts (never exposed to the browser).
# Supabase → Connect → "Session pooler" connection string.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
